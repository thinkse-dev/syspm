# Editor defaults. Formatting itself is enforced by rustfmt (Rust) and dprint
# (Markdown, TOML, JSON, YAML); these settings only keep editors consistent with them.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.rs]
# rustfmt default max_width
max_line_length = 100

[*.{toml,yml,yaml,json,md}]
indent_size = 2

[*.md]
# Two trailing spaces are a Markdown hard line break.
trim_trailing_whitespace = false

[Cargo.lock]
# Generated by Cargo.
trim_trailing_whitespace = unset
insert_final_newline = unset

[tests/fixtures/**]
# Fixtures may intentionally contain unusual formatting.
trim_trailing_whitespace = unset
insert_final_newline = unset
