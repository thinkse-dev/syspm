      "expected_order": null,
      "expected_errors": [
        {
          "rule": "case-collision",
          "paths": [
            "STRASSE.sysml",
            "Straße.sysml"
          ]
        },
        {
          "rule": "case-collision",
          "paths": [
            "file.sysml",
            "ﬁle.sysml"
          ]
        },
        {
          "rule": "case-collision",
          "paths": [
            "K.sysml",
            "k.sysml"
          ]
        }
      ],
      "expected_warnings": []
    },
    {
      "name": "ordering",
      "description": "Bytewise order of the full UTF-8 path: uppercase before lowercase; 'a-b' (0x2D) before 'a/x' (0x2F), unlike sorting by segment; 'é' (0xC3...) after 'z', unlike most locales.",
      "paths": [
        "z.sysml",
        "a/x.sysml",
        "é.sysml",
        "a-b.sysml",
        "a.b/x.sysml",
        "a.sysml",
        "B.sysml"
      ],
      "expected_order": [
        "B.sysml",
        "a-b.sysml",
        "a.b/x.sysml",
        "a.sysml",
        "a/x.sysml",
        "z.sysml",
        "é.sysml"
      ],
      "expected_errors": [],
      "expected_warnings": []
    },
