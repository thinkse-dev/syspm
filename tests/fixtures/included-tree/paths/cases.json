    {
      "name": "nfd-name-alone",
      "description": "A decomposed name (e + U+0300), as macOS can present it, becomes its NFC form.",
      "paths": [
        "Modèle.sysml"
      ],
      "expected_order": [
        "Modèle.sysml"
      ],
      "expected_errors": [],
      "expected_warnings": []
    },
    {
      "name": "nfd-and-nfc-in-one-tree",
      "description": "Two members whose names differ only in normalization: possible on Linux, in Git with precomposeunicode=false, and in ZIP.",
      "paths": [
        "Modèle.sysml",
        "Modèle.sysml"
      ],
      "expected_order": null,
      "expected_errors": [
        {
          "rule": "normalization-collision",
          "paths": [
            "Modèle.sysml",
            "Modèle.sysml"
          ]
        }
      ],
      "expected_warnings": []
    },
    {
