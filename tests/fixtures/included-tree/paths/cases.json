    {
      "name": "case-collision-full-folding",
      "description": "Collisions that need full folding or NFKC: sharp s, fi ligature, and the Kelvin sign, which NFC alone already maps to ASCII K (a singleton decomposition), so its canonical path is K.sysml. All three also collide on APFS.",
      "paths": [
        "Straße.sysml",
        "STRASSE.sysml",
        "K.sysml",
        "k.sysml",
        "ﬁle.sysml",
        "file.sysml"
