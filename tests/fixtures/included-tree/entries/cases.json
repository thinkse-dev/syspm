    {
      "name": "archive-unicode-path-field",
      "source": "archive",
      "description": "A1: a Unicode Path extra field is accepted only when it is version 1, its CRC matches the header name and its name equals the header name (A.sysml). A different name, a stale CRC or another version is unicode-path-mismatch.",
      "archive": [
        {
          "name": ".project.json",
          "text": "{\"name\": \"p\", \"version\": \"1.0.0\"}\n"
        },
        {
          "name": "A.sysml",
          "text": "package A;\n",
          "upath": {
            "name": "A.sysml"
          }
        },
        {
          "name": "B.sysml",
          "text": "package B;\n",
          "upath": {
            "name": "C.sysml"
          }
        },
        {
          "name": "D.sysml",
          "text": "package D;\n",
          "upath": {
            "name": "D.sysml",
            "crc_of_name": false
          }
        },
        {
          "name": "E.sysml",
          "text": "package E;\n",
          "upath": {
            "name": "E.sysml",
            "version": 2
          }
        }
      ],
      "expected_members": null,
      "expected_errors": [
        {
          "rule": "unicode-path-mismatch",
          "paths": [
            "B.sysml"
          ]
        },
        {
          "rule": "unicode-path-mismatch",
          "paths": [
            "D.sysml"
          ]
        },
        {
          "rule": "unicode-path-mismatch",
          "paths": [
            "E.sysml"
          ]
        }
      ],
      "expected_warnings": []
    },
