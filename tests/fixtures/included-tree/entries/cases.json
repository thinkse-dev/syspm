    {
      "name": "directory-checkout-filtered",
      "source": "directory",
      "description": "B3: a directory inside a Git working tree is hashed as it is on disk. A.sysml was converted to CRLF on checkout (Git considers it unmodified: clean_matches), so it is a member with CRLF bytes and a checkout-filtered warning. B.sysml was edited, which is not a filter effect, so there is no warning. C.sysml is identical to its blob.",
      "entries": [
        {
          "path": ".project.json",
          "type": "file",
          "mode": "0644",
          "text": "{\"name\": \"p\", \"version\": \"1.0.0\"}\n",
          "git": {
            "text": "{\"name\": \"p\", \"version\": \"1.0.0\"}\n",
            "clean_matches": true
          }
        },
        {
          "path": "A.sysml",
          "type": "file",
          "mode": "0644",
          "hex": "7061636b61676520413b0d0a",
          "git": {
            "text": "package A;\n",
            "clean_matches": true
          }
        },
        {
          "path": "B.sysml",
          "type": "file",
          "mode": "0644",
          "text": "package B2;\n",
          "git": {
            "text": "package B;\n",
            "clean_matches": false
          }
        },
        {
          "path": "C.sysml",
          "type": "file",
          "mode": "0644",
          "text": "package C;\n",
          "git": {
            "text": "package C;\n",
            "clean_matches": true
          }
        }
      ],
      "expected_members": [
        {
          "path": ".project.json",
          "text": "{\"name\": \"p\", \"version\": \"1.0.0\"}\n"
        },
        {
          "path": "A.sysml",
          "hex": "7061636b61676520413b0d0a"
        },
        {
          "path": "B.sysml",
          "text": "package B2;\n"
        },
        {
          "path": "C.sysml",
          "text": "package C;\n"
        }
      ],
      "expected_errors": [],
      "expected_warnings": [
        {
          "rule": "checkout-filtered",
          "paths": [
            "A.sysml"
          ]
        }
      ]
    },
    {
      "name": "git-tree-blobs",
