{
  "_comment": "Entry-type, byte and archive test vectors (docs/specs/included-tree.md, section 4). Directory and git cases list entries as the source reports them (lstat; git ls-tree -r -t). Archive cases are ZIP specifications; archives/<name>.zip is the archive built from each, byte for byte. Expected members (canonical path and exact bytes, in canonical order; null when there are errors), errors and warnings are written by hand.",
  "cases": [
    {
      "name": "directory-regular-files",
      "source": "directory",
      "description": "E3, E4, M1: directories (including an empty one) are not members, two hard links to one file are two members with the same bytes, an executable file and an empty file are ordinary members.",
      "entries": [
        {
          "path": ".project.json",
          "type": "file",
          "mode": "0644",
          "text": "{\"name\": \"p\", \"version\": \"1.0.0\"}\n"
        },
        {
          "path": "models",
          "type": "directory",
          "mode": "0755"
        },
        {
          "path": "models/A.sysml",
          "type": "file",
          "mode": "0644",
          "text": "package A;\n",
          "inode": 101
        },
        {
          "path": "models/A-hardlink.sysml",
          "type": "file",
          "mode": "0644",
          "text": "package A;\n",
          "inode": 101
        },
        {
          "path": "tools",
          "type": "directory",
          "mode": "0755"
        },
        {
          "path": "tools/gen.sh",
          "type": "file",
          "mode": "0755",
          "text": "#!/bin/sh\n"
        },
        {
          "path": "empty",
          "type": "directory",
          "mode": "0755"
        },
        {
          "path": "empty.txt",
          "type": "file",
          "mode": "0644",
          "text": ""
        }
      ],
      "expected_members": [
        {
          "path": ".project.json",
          "text": "{\"name\": \"p\", \"version\": \"1.0.0\"}\n"
        },
        {
          "path": "empty.txt",
          "text": ""
        },
        {
          "path": "models/A-hardlink.sysml",
          "text": "package A;\n"
        },
        {
          "path": "models/A.sysml",
          "text": "package A;\n"
        },
        {
          "path": "tools/gen.sh",
          "text": "#!/bin/sh\n"
        }
      ],
      "expected_errors": [],
      "expected_warnings": []
    },
    {
      "name": "directory-symbolic-links",
      "source": "directory",
      "description": "E1: a link to a file, a link to a directory, a dangling link and a linked .meta.json are each an error; links are never followed.",
      "entries": [
        {
          "path": ".project.json",
          "type": "file",
          "mode": "0644",
          "text": "{\"name\": \"p\", \"version\": \"1.0.0\"}\n"
        },
        {
          "path": ".meta.json",
          "type": "symlink",
          "target": "../shared/.meta.json"
        },
        {
          "path": "models",
          "type": "directory",
          "mode": "0755"
        },
        {
          "path": "models/A.sysml",
          "type": "file",
          "mode": "0644",
          "text": "package A;\n"
        },
        {
          "path": "models/B.sysml",
          "type": "symlink",
          "target": "A.sysml"
        },
        {
          "path": "linked",
          "type": "symlink",
          "target": "models"
        },
        {
          "path": "gone.sysml",
          "type": "symlink",
          "target": "does-not-exist.sysml"
        }
      ],
      "expected_members": null,
      "expected_errors": [
        {
          "rule": "symbolic-link",
          "paths": [
            ".meta.json"
          ]
        },
        {
          "rule": "symbolic-link",
          "paths": [
            "models/B.sysml"
          ]
        },
        {
          "rule": "symbolic-link",
          "paths": [
            "linked"
          ]
        },
        {
          "rule": "symbolic-link",
          "paths": [
            "gone.sysml"
          ]
        }
      ],
      "expected_warnings": []
    },
