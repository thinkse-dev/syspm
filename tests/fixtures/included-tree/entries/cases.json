          "path": "models",
          "mode": "040000"
        },
        {
          "path": "models/A.sysml",
          "mode": "100644",
          "text": "package A;\n",
          "checkout_text": "package A;\r\n"
        },
        {
          "path": "tools",
          "mode": "040000"
        },
        {
          "path": "tools/gen.sh",
          "mode": "100755",
          "text": "#!/bin/sh\n"
        }
      ],
      "expected_members": [
        {
          "path": ".project.json",
          "text": "{\"name\": \"p\", \"version\": \"1.0.0\"}\n"
        },
        {
          "path": "models/A.sysml",
          "text": "package A;\n"
        },
        {
          "path": "tools/gen.sh",
          "text": "#!/bin/sh\n"
        }
      ],
      "expected_errors": [],
      "expected_warnings": []
    },
