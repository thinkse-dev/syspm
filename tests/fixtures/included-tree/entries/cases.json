    {
      "name": "archive-links-and-special",
      "source": "archive",
      "description": "E1, E2 from Unix modes: a link entry and a named pipe entry are errors. A link under __MACOSX/ is excluded by selection first.",
      "archive": [
        {
          "name": ".project.json",
          "text": "{\"name\": \"p\", \"version\": \"1.0.0\"}\n"
        },
        {
          "name": "models/A.sysml",
          "text": "package A;\n"
        },
        {
          "name": "models/link.sysml",
          "text": "A.sysml",
          "mode": "120777",
          "method": 0
        },
        {
          "name": "pipe",
          "mode": "010644"
        },
        {
          "name": "__MACOSX/link",
