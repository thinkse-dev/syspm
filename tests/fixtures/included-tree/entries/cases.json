    {
      "name": "archive-name-encoding",
      "source": "archive",
      "description": "A1: a non-ASCII name without the UTF-8 flag is accepted when its bytes are valid UTF-8, with an undeclared-name-encoding warning. Bytes that are not UTF-8 (CP437 0x8A), even with a Unicode Path extra field (0x7075) giving a UTF-8 name, are an error. A flagged name that is not UTF-8 fails P1.",
      "archive": [
        {
          "name": ".project.json",
          "text": "{\"name\": \"p\", \"version\": \"1.0.0\"}\n"
        },
        {
          "name": "Modèle.sysml",
          "text": "package M;\n"
        },
        {
          "name_hex": "4d6f648a6c652e73796d6c",
          "text": "package M;\n"
        },
        {
          "name_hex": "4d6f648a6c65322e73796d6c",
          "text": "package M2;\n",
          "upath": {
            "name": "Modèle2.sysml"
          }
        },
        {
          "name_hex": "4d6fff2e73796d6c",
          "text": "package X;\n",
          "utf8_flag": true
        }
      ],
      "expected_members": null,
      "expected_errors": [
        {
          "rule": "undeclared-name-encoding",
          "paths": [
            "4d6f648a6c652e73796d6c"
          ]
        },
        {
          "rule": "undeclared-name-encoding",
          "paths": [
            "4d6f648a6c65322e73796d6c"
          ]
        },
        {
          "rule": "invalid-utf8",
          "paths": [
            "4d6fff2e73796d6c"
          ]
        }
      ],
      "expected_warnings": [
        {
          "rule": "undeclared-name-encoding",
          "paths": [
            "Modèle.sysml"
          ]
        }
      ]
    },
